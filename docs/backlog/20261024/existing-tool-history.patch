+  if (bytes === undefined) entries.delete(model);
+  else entries.set(model, bytes);
+  const { defaulted: _defaulted, modelMinBytes: _previous, ...rest } = current;
+  return writeSettings({ ...rest, ...modelThresholds(Object.fromEntries(entries)) });
